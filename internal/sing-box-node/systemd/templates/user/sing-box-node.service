# Managed by sing-box-node system install.

[Unit]
Description=Sing-Box Node user agent
Documentation=https://github.com/rehuony/sing-box-panel
Wants=network-online.target
After=network-online.target

[Service]
Environment=SING_BOX_SYSTEMD_SCOPE=user
Environment=SING_BOX_NODE_SUPERVISOR=systemd
Type=simple
ExecStart=%h/.local/bin/sing-box-node server start --config %h/.config/sing-box-node/setting.json
WorkingDirectory=%h/.local/share/sing-box-node
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=mixed
UMask=0077

RuntimeDirectory=sing-box-node
RuntimeDirectoryMode=0700

# No file system or kernel protection, unlike the system unit: a user manager
# applies them only in a user namespace, which hides the root ownership the
# artifact store checks.
NoNewPrivileges=true
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=default.target
