# Managed by sing-box-node system install.

[Unit]
Description=Sing-Box Node user agent
Documentation=https://github.com/rehuony/sing-box-panel
Wants=network-online.target
After=network-online.target

[Service]
Environment=SING_BOX_SYSTEMD_SCOPE=user
Type=simple
ExecStart=%h/.local/bin/sing-box-node --data-dir %h/.local/share/sing-box-node run
WorkingDirectory=%h/.local/share/sing-box-node
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=mixed
UMask=0077

RuntimeDirectory=sing-box-node
RuntimeDirectoryMode=0700

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/sing-box-node
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=default.target
