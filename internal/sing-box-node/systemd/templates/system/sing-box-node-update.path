# Managed by sing-box-node system install.

[Unit]
Description=Sing-Box Node update request
Documentation=https://github.com/rehuony/sing-box-panel

[Path]
PathExists=/var/lib/sing-box-node/updates/request
Unit=sing-box-node-update.service

[Install]
WantedBy=paths.target
