{
  "name": "@sing-box-panel/panel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate": "openapi-ts -i ../../../api/panel-openapi.yaml -o src/api/generated -p @hey-api/typescript --no-log-file && node --experimental-strip-types scripts/configuration-schema.ts",
    "schema:check": "node --experimental-strip-types scripts/configuration-schema.ts --check",
    "dev": "pnpm run generate && vite",
    "build": "pnpm run generate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm run generate && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fingerprintjs/fingerprintjs": "5.2.0",
    "@lezer/highlight": "^1.2.3",
    "@rjsf/core": "6.8.0",
    "@rjsf/utils": "6.8.0",
    "@rjsf/validator-ajv8": "6.8.0",
    "@sing-box-panel/shared": "workspace:*",
    "@tanstack/react-query": "^5.104.0",
    "ajv": "8.20.0",
    "codemirror": "^6.0.2",
    "i18next": "26.4.0",
    "lossless-json": "4.3.1",
    "lucide-react": "0.511.0",
    "motion": "^13.1.1",
    "react": "19.2.8",
    "react-colorful": "^5.8.1",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.12",
    "react-router-dom": "7.18.2",
    "uplot": "1.6.32",
    "zustand": "5.0.15"
  }
}
