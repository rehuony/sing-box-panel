{
  "name": "sing-box-panel-web",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "scripts": {
    "generate": "pnpm --recursive --filter './apps/*' run generate",
    "build": "pnpm --recursive --filter './apps/*' run build",
    "typecheck": "pnpm --recursive --filter './apps/*' run typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "pnpm run generate && pnpm --recursive run test"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@eslint-react/eslint-plugin": "catalog:",
    "@hey-api/openapi-ts": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "jsdom": "catalog:",
    "shadcn": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12"
  }
}
