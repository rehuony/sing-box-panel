{
  "name": "sing-box-panel-web",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "scripts": {
    "api:generate": "openapi-ts -i ../api/openapi.yaml -o src/api/generated -p @hey-api/typescript --no-log-file",
    "dev": "pnpm run api:generate && vite",
    "demo": "pnpm run api:generate && vite --mode demo",
    "build": "pnpm run api:generate && tsc --noEmit && vite build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "pnpm run api:generate && vitest run",
    "test:watch": "pnpm run api:generate && vitest",
    "typecheck": "pnpm run api:generate && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@lezer/highlight": "^1.2.3",
    "@rjsf/core": "6.8.0",
    "@rjsf/utils": "6.8.0",
    "@rjsf/validator-ajv8": "6.8.0",
    "ajv": "8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "i18next": "26.4.0",
    "lossless-json": "4.3.1",
    "lucide-react": "0.511.0",
    "motion": "^13.1.1",
    "react": "19.2.8",
    "react-colorful": "^5.8.1",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.12",
    "react-router-dom": "7.18.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uplot": "1.6.32",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@eslint-react/eslint-plugin": "5.18.6",
    "@hey-api/openapi-ts": "0.99.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "^24.10.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-format": "2.0.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "jsdom": "30.0.1",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.12"
  }
}
