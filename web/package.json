{
  "name": "sing-box-panel-web",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "scripts": {
    "generate": "pnpm --recursive --filter './apps/*' run generate",
    "build": "pnpm --recursive --filter './apps/*' run build",
    "typecheck": "pnpm --recursive --filter './apps/*' run typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "pnpm run generate && pnpm --recursive run test"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@eslint-react/eslint-plugin": "5.18.6",
    "@hey-api/openapi-ts": "0.99.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "^24.10.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-format": "2.0.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "jsdom": "30.0.1",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.12"
  }
}
