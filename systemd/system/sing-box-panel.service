# Managed by sing-box-panel system install.

[Unit]
Description=Sing-Box Panel control plane
Documentation=https://github.com/rehuony/sing-box-panel
Wants=network-online.target
After=network-online.target

[Service]
Environment=SING_BOX_PANEL_SUPERVISOR=systemd
Environment=SING_BOX_PANEL_HOST_PROC=/run/sing-box-panel/host-proc
Type=simple
User=sing-box-panel
Group=sing-box-panel
ExecStart=/usr/local/bin/sing-box-panel server start --config /etc/sing-box-panel/setting.json
WorkingDirectory=/var/lib/sing-box-panel
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=mixed
UMask=0077

StateDirectory=sing-box-panel
StateDirectoryMode=0700
RuntimeDirectory=sing-box-panel
RuntimeDirectoryMode=0700
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ReadWritePaths=/etc/sing-box-panel
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
# Expose only the host counters needed by the dashboard, as read-only files.
BindReadOnlyPaths=/proc/stat:/run/sing-box-panel/host-proc/stat /proc/meminfo:/run/sing-box-panel/host-proc/meminfo /proc/loadavg:/run/sing-box-panel/host-proc/loadavg
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
